# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS compiled
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY extension ./extension
COPY src ./src
COPY tsconfig.json ./
COPY scripts/bundle.mjs ./scripts/
RUN npm run typecheck && npm run build:bundle

FROM mcr.microsoft.com/playwright/python:v1.58.0-noble@sha256:678457c4c323b981d8b4befc57b95366bb1bb6aa30057b1269f6b171e8d9975a AS integration
WORKDIR /app
COPY --from=backend requirements.runtime.lock.txt ./
RUN pip install --no-cache-dir -r requirements.runtime.lock.txt playwright==1.58.0 pytest==8.3.5
COPY --from=backend requirements.sdk.lock.txt ./
RUN python -m pip --isolated install --no-cache-dir --no-deps --only-binary=:all: \
    --index-url https://pypi.org/simple --require-hashes -r requirements.sdk.lock.txt \
    && python -m pip check
COPY --from=backend backend ./backend
COPY --from=backend tests/capture_factory.py tests/mirror_factory.py tests/delivery_factory.py ./fixture_helpers/
COPY extension ./extension
COPY scripts/build.py ./scripts/build.py
COPY --from=compiled /app/.local/bundle ./.local/bundle
COPY LICENSE PRIVACY.md THIRD_PARTY_NOTICES.md ./
RUN python scripts/build.py --compiled .local/bundle
COPY tests/browser ./tests/browser
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/fixture_helpers
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/browser"]

# Explicit acceptance target: local CA and native permission dialogs in Xvfb.
# It is never part of the shipped extension or the backend runtime image.
FROM integration AS migration-acceptance
RUN apt-get update && apt-get install -y --no-install-recommends libnss3-tools xdotool scrot && rm -rf /var/lib/apt/lists/*
COPY --from=backend scripts/migration_lab.py scripts/migration_history.py ./scripts/
COPY scripts/browser_migration.py ./scripts/browser_migration.py
ENV PYTHONPATH=/app:/app/fixture_helpers:/app/tests/browser:/app/scripts
CMD ["xvfb-run", "-a", "python", "scripts/browser_migration.py", "--fake"]

# Native local engine compared with the isolated Python reference implementation.
FROM migration-acceptance AS local-integration
COPY --from=compiled /app/.local/probes ./.local/probes
COPY contracts ./contracts
COPY tests/local ./tests/local
COPY --from=backend tests/test_transfer_recovery.py ./fixture_helpers/
CMD ["xvfb-run", "-a", "python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/local/test_mirror_parity.py"]

# Actual Python HTTP interoperability at the same pinned minimum browser.
# Keep this binary/hash aligned with Dockerfile's local-chrome140 target.
FROM mcr.microsoft.com/playwright/python:v1.58.0-noble@sha256:678457c4c323b981d8b4befc57b95366bb1bb6aa30057b1269f6b171e8d9975a AS integration-chrome140-binary
RUN curl -fsSL https://storage.googleapis.com/chrome-for-testing-public/140.0.7339.80/linux64/chrome-linux64.zip -o /tmp/chrome.zip \
    && echo '7184052e2155f270dd49503b1c9c7163204f3a7bc0fba9bd9e746dde04eb0546  /tmp/chrome.zip' | sha256sum -c - \
    && python -m zipfile -e /tmp/chrome.zip /opt/chrome140 \
    && chmod +x /opt/chrome140/chrome-linux64/chrome /opt/chrome140/chrome-linux64/chrome_crashpad_handler /opt/chrome140/chrome-linux64/chrome_sandbox \
    && rm /tmp/chrome.zip

FROM local-integration AS local-integration-chrome140
COPY --from=integration-chrome140-binary /opt/chrome140 /opt/chrome140
ENV CHROME_EXECUTABLE=/opt/chrome140/chrome-linux64/chrome
